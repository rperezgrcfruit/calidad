# ============================================================
# PLANTILLA DE CONFIGURACIÓN
# ============================================================
# Copiar este archivo como ".env" y completar los valores.
#
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
#
# El archivo .env NO se versiona (contiene credenciales).
# ============================================================

# Entorno: local | production | staging
APP_ENV=local

# URL base de la aplicación
#   Local: http://localhost/calidad
#   VPS:   https://grcfruit.cl/calidad
APP_URL=http://localhost/calidad

# Ruta raíz que contiene la carpeta "calidad"
#   Local: C:/xampp/htdocs
#   VPS:   /home/grcfruit/public_html
# (Opcional: si se omite se detecta automáticamente)
#APP_PATH=

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=grcfruit_grc
DB_USER=root
DB_PASS=
DB_CHARSET=utf8

# ------------------------------------------------------------
# API de archivos (GUIA de recepciones de químicos)
# ------------------------------------------------------------
# Misma API que usa la aplicación VB.NET. Por defecto apunta a:
#   http://app.grcfruit.cl/apis/backup_files
# Solo se define aquí si necesitas otro servidor.
#QUIMICOS_API_URL=http://app.grcfruit.cl/apis/backup_files
